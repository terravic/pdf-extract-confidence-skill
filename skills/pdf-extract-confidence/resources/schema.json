{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDFWordConfidenceExtractionOutput",
  "description": "Schema for PDF text extraction with normalized word-level confidence scores.",
  "type": "object",
  "required": [
    "metadata",
    "full_text",
    "pages",
    "low_confidence_words"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "filename",
        "total_pages",
        "extraction_engine",
        "timestamp_utc",
        "total_words",
        "mean_confidence",
        "min_confidence",
        "low_confidence_count",
        "low_confidence_threshold"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "description": "Name or relative path of the processed PDF file."
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of pages processed."
        },
        "extraction_engine": {
          "type": "string",
          "description": "Identification of the extraction engine or hybrid pipeline used."
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of the extraction."
        },
        "total_words": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of extracted words across all pages."
        },
        "mean_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Arithmetic mean of confidence scores across all extracted words."
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Lowest confidence score encountered across all words."
        },
        "low_confidence_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of words scoring below the specified low_confidence_threshold."
        },
        "low_confidence_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "The confidence score cutoff below which words are flagged."
        }
      },
      "additionalProperties": false
    },
    "full_text": {
      "type": "string",
      "description": "Consolidated plain text from the entire document, formatted for immediate NLP/LLM consumption."
    },
    "pages": {
      "type": "array",
      "description": "Per-page text and word breakdown.",
      "items": {
        "type": "object",
        "required": [
          "page_number",
          "page_type",
          "width",
          "height",
          "word_count",
          "mean_confidence",
          "text",
          "words"
        ],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page index."
          },
          "page_type": {
            "type": "string",
            "enum": ["digital", "ocr", "hybrid", "empty"],
            "description": "The extraction source modality for this specific page."
          },
          "width": {
            "type": "number",
            "description": "Page width in points (72 points = 1 inch)."
          },
          "height": {
            "type": "number",
            "description": "Page height in points (72 points = 1 inch)."
          },
          "word_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of words extracted from this page."
          },
          "mean_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Average word confidence score for this page."
          },
          "text": {
            "type": "string",
            "description": "Full extracted plain text for this specific page."
          },
          "words": {
            "type": "array",
            "description": "Ordered list of individual words with coordinates and confidence scores.",
            "items": {
              "type": "object",
              "required": [
                "word",
                "confidence",
                "source",
                "bbox"
              ],
              "properties": {
                "word": {
                  "type": "string",
                  "description": "Extracted word text token."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0,
                  "description": "Recognition confidence score between 0.0 and 1.0."
                },
                "source": {
                  "type": "string",
                  "enum": ["digital", "ocr", "cloud_docai", "cloud_textract"],
                  "description": "Origin of the word token recognition."
                },
                "bbox": {
                  "type": "object",
                  "required": ["x0", "top", "x1", "bottom"],
                  "properties": {
                    "x0": { "type": "number", "description": "Left coordinate in points." },
                    "top": { "type": "number", "description": "Top coordinate in points." },
                    "x1": { "type": "number", "description": "Right coordinate in points." },
                    "bottom": { "type": "number", "description": "Bottom coordinate in points." }
                  },
                  "additionalProperties": false
                },
                "line_number": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Optional 1-based line number on the page."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "low_confidence_words": {
      "type": "array",
      "description": "List of words with confidence scores strictly below the threshold for rapid auditing.",
      "items": {
        "type": "object",
        "required": [
          "word",
          "confidence",
          "page",
          "source",
          "bbox",
          "reason"
        ],
        "properties": {
          "word": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "page": { "type": "integer", "minimum": 1 },
          "source": { "type": "string" },
          "bbox": {
            "type": "object",
            "required": ["x0", "top", "x1", "bottom"],
            "properties": {
              "x0": { "type": "number" },
              "top": { "type": "number" },
              "x1": { "type": "number" },
              "bottom": { "type": "number" }
            },
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "description": "Explanation for the lower confidence rating (e.g. ocr_uncertainty, encoding_anomaly, image_noise)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
